# Base de donnees PostgreSQL
DATABASE_URL="postgresql://activite_user:activite_password@localhost:5432/activite_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="votre-secret-de-production-a-changer"

# Stripe - Abonnements
# Creer un compte sur https://dashboard.stripe.com
# Recuperer les cles dans Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Creer un produit et un prix mensuel (15 EUR) dans Products
STRIPE_PRICE_ID="price_..."

# Configurer le webhook pour: customer.subscription.*, checkout.session.completed
# Recuperer le secret dans Developers > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# Upload
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE=31457280  # 30 Mo pour les videos
