# ============================================
# SaaS Activités - Configuration Environnement
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ============================================
# Base de données PostgreSQL (REQUIS)
# ============================================
DATABASE_URL="postgresql://activite_user:activite_password@localhost:5432/activite_db?schema=public"

# ============================================
# Authentification (REQUIS)
# ============================================
# Génerer avec: openssl rand -hex 32
AUTH_SECRET="votre-secret-de-production-minimum-32-caracteres"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ============================================
# Stripe - Abonnements (OPTIONNEL)
# ============================================
# Sans Stripe, les fonctionnalités d'abonnement sont désactivées
# Créer un compte sur https://dashboard.stripe.com
# Récupérer les clés dans Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Créer un produit et un prix mensuel (15 EUR) dans Products
STRIPE_PRICE_ID="price_..."

# Configurer le webhook pour: customer.subscription.*, checkout.session.completed
# Récupérer le secret dans Developers > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# Redis - Rate Limiting (OPTIONNEL)
# ============================================
# Sans Redis, utilise un rate limiting en mémoire (OK pour instance unique)
# Pour plusieurs instances, Redis est recommandé
REDIS_URL="redis://localhost:6379"

# ============================================
# SMTP - Emails (OPTIONNEL)
# ============================================
# Sans SMTP, la vérification email est désactivée
# Services: Mailgun, SendGrid, Postmark, ou SMTP standard
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="votre-email@example.com"
SMTP_PASS="votre-mot-de-passe"
SMTP_FROM="noreply@votre-domaine.com"

# ============================================
# Cloudflare Turnstile - CAPTCHA (OPTIONNEL)
# ============================================
# Sans Turnstile, utilise honeypot + timing (protection basique)
# Créer un site sur https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY="0x..."
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."

# ============================================
# Environnement Node
# ============================================
NODE_ENV="development"
